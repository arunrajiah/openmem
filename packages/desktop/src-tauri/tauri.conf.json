{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMem",
  "version": "0.0.0",
  "identifier": "io.github.arunrajiah.openmem",
  "build": {
    "beforeDevCommand": "pnpm run predev",
    "devUrl": "http://localhost:7410",
    "beforeBuildCommand": "pnpm run prebuild",
    "frontendDist": "../dist-placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenMem",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/openmem-companion"],
    "category": "Productivity",
    "shortDescription": "Local-first AI conversation memory",
    "longDescription": "Capture and search your Claude, ChatGPT, and Gemini conversations in one local, private database."
  }
}
